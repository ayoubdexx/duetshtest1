# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For Supabase: Project Settings → Database →
# Connection string (use the "Transaction" pooler URL for serverless deploys
# and set DIRECT_URL to the direct connection for migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deutschwerk"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
AUTH_TRUST_HOST="true"
# Public URL of the app (used in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional) ────────────────────────────────────────────────────────
# When set, verification & password-reset emails are sent via Resend.
# When unset, the app runs in dev-mail mode: links are logged to the server
# console and surfaced on-screen so you can complete the flows locally.
RESEND_API_KEY=""
EMAIL_FROM="Deutschwerk <onboarding@resend.dev>"

# ── AI feedback (optional) ──────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. When unset, writing feedback falls back to
# built-in rule-based checks + native sample answers.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
