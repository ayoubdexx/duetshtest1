// Deutschwerk — Prisma schema (PostgreSQL / Supabase-compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum LessonType {
  STANDARD
  REVISION
  MINI_TEST
  FINAL_EXAM
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SkillArea {
  GRAMMAR
  VOCABULARY
  READING
  LISTENING
  WRITING
  SPEAKING
  PRONUNCIATION
  EXAM
}

enum ExerciseType {
  MCQ
  GAP_FILL
  ORDERING
  MATCHING
}

enum ExamProvider {
  GOETHE
  TELC
}

enum WritingType {
  EMAIL
  LETTER
  MESSAGE
  ESSAY
  EXAM_TASK
}

enum SpeakingType {
  ROLEPLAY
  CONVERSATION
  INTERVIEW
  PRONUNCIATION
  CHALLENGE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum BookmarkType {
  LESSON
  GRAMMAR
  VOCAB_TOPIC
  WORD
  READING
  LISTENING
  SPEAKING
  WRITING
  EXERCISE
  EXAM
  VERB
}

enum PlannerItemType {
  LESSON
  REVIEW
  EXERCISE
  EXAM
  CUSTOM
}

// ─────────────────────── Users & Auth ────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String
  avatarUrl      String?
  role           Role      @default(STUDENT)
  bio            String?
  nativeLanguage String?
  currentLevel   String    @default("A1")
  dailyGoalMin   Int       @default(20)
  xp             Int       @default(0)
  streak         Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveAt   DateTime?
  examDate       DateTime?
  examTarget     String?
  settings       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lessonProgress     LessonProgress[]
  exerciseAttempts   ExerciseAttempt[]
  examAttempts       ExamAttempt[]
  writingSubmissions WritingSubmission[]
  flashcards         Flashcard[]
  reviewLogs         ReviewLog[]
  studyActivities    StudyActivity[]
  skillScores        SkillScore[]
  notes              Note[]
  noteFolders        NoteFolder[]
  bookmarks          Bookmark[]
  ownedGroups        StudyGroup[]      @relation("GroupOwner")
  groupMemberships   GroupMember[]
  groupMessages      GroupMessage[]
  posts              Post[]
  comments           Comment[]
  achievements       UserAchievement[]
  plannerItems       PlannerItem[]
  goals              Goal[]
  certificates       Certificate[]
  announcements      Announcement[]
}

model AuthToken {
  id         String    @id @default(cuid())
  identifier String
  token      String    @unique
  type       TokenType
  expires    DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
}

// ─────────────────────── Curriculum ──────────────────────────

model Level {
  code        String @id
  title       String
  tagline     String
  description String
  color       String
  order       Int

  modules       Module[]
  grammarTopics GrammarTopic[]
  vocabTopics   VocabTopic[]
  readings      ReadingText[]
  listenings    ListeningExercise[]
  speakings     SpeakingActivity[]
  writingTasks  WritingTask[]
  exercises     Exercise[]
  exams         MockExam[]
}

model Module {
  id          String @id @default(cuid())
  levelCode   String
  order       Int
  slug        String @unique
  title       String
  description String
  icon        String @default("book")

  level   Level    @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  lessons Lesson[]

  @@index([levelCode, order])
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  order       Int
  slug        String     @unique
  title       String
  subtitle    String?
  type        LessonType @default(STANDARD)
  durationMin Int        @default(25)
  xpReward    Int        @default(50)
  objectives  Json?
  blocks      Json
  homework    Json?
  published   Boolean    @default(true)

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  exercises Exercise[]

  @@index([moduleId, order])
}

model GrammarTopic {
  id         String  @id @default(cuid())
  slug       String  @unique
  levelCode  String
  order      Int
  title      String
  category   String
  summary    String
  blocks     Json
  cheatSheet Json?

  level     Level      @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  exercises Exercise[]

  @@index([levelCode, order])
}

model VocabTopic {
  id          String  @id @default(cuid())
  slug        String  @unique
  levelCode   String
  order       Int
  title       String
  description String?
  icon        String  @default("book-a")

  level Level       @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  words VocabWord[]

  @@index([levelCode, order])
}

model VocabWord {
  id          String  @id @default(cuid())
  topicId     String
  german      String
  article     String?
  plural      String?
  pos         String  @default("noun")
  ipa         String?
  meaning     String
  exampleDe   String
  exampleEn   String?
  synonyms    Json?
  opposites   Json?
  expressions Json?
  memoryTip   String?
  difficulty  Int     @default(1)
  audioUrl    String?

  topic      VocabTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([topicId])
  @@index([german])
}

model Verb {
  id          String  @id @default(cuid())
  infinitive  String  @unique
  english     String
  levelCode   String  @default("A1")
  isIrregular Boolean @default(false)
  isSeparable Boolean @default(false)
  auxiliary   String  @default("haben")
  partizip2   String
  forms       Json
  examples    Json?

  @@index([levelCode])
}

model ReadingText {
  id           String  @id @default(cuid())
  slug         String  @unique
  levelCode    String
  order        Int
  title        String
  topic        String?
  wordCount    Int     @default(0)
  intro        String?
  body         String
  glossary     Json?
  grammarNotes Json?
  questions    Json

  level Level @relation(fields: [levelCode], references: [code], onDelete: Cascade)

  @@index([levelCode, order])
}

model ListeningExercise {
  id          String  @id @default(cuid())
  slug        String  @unique
  levelCode   String
  order       Int
  title       String
  description String?
  audioUrl    String
  durationSec Int     @default(0)
  transcript  String
  vocabulary  Json?
  questions   Json

  level Level @relation(fields: [levelCode], references: [code], onDelete: Cascade)

  @@index([levelCode, order])
}

model SpeakingActivity {
  id          String       @id @default(cuid())
  slug        String       @unique
  levelCode   String
  order       Int
  title       String
  type        SpeakingType
  description String?
  prompt      String
  dialogue    Json?
  phrases     Json?
  tips        Json?

  level Level @relation(fields: [levelCode], references: [code], onDelete: Cascade)

  @@index([levelCode, order])
}

model WritingTask {
  id           String      @id @default(cuid())
  slug         String      @unique
  levelCode    String
  order        Int
  title        String
  type         WritingType
  prompt       String
  minWords     Int         @default(50)
  template     Json?
  sampleAnswer String?
  tips         Json?

  level       Level               @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  submissions WritingSubmission[]

  @@index([levelCode, order])
}

model WritingSubmission {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  content   String
  feedback  Json?
  score     Int?
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task WritingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
}

model Exercise {
  id             String       @id @default(cuid())
  slug           String       @unique
  levelCode      String
  title          String
  skill          SkillArea
  type           ExerciseType
  instructions   String?
  questions      Json
  xpReward       Int          @default(10)
  grammarTopicId String?
  lessonId       String?

  level        Level             @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  grammarTopic GrammarTopic?     @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  lesson       Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts     ExerciseAttempt[]

  @@index([levelCode, skill])
}

model MockExam {
  id          String       @id @default(cuid())
  slug        String       @unique
  provider    ExamProvider
  levelCode   String
  title       String
  description String?
  durationMin Int
  passScore   Int          @default(60)
  sections    Json

  level    Level         @relation(fields: [levelCode], references: [code], onDelete: Cascade)
  attempts ExamAttempt[]

  @@index([levelCode, provider])
}

// ─────────────────────── User progress ───────────────────────

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(IN_PROGRESS)
  blockIndex  Int            @default(0)
  score       Float?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  correct    Int
  total      Int
  answers    Json?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
}

model ExamAttempt {
  id            String    @id @default(cuid())
  userId        String
  examId        String
  answers       Json?
  score         Float?
  maxScore      Float?
  sectionScores Json?
  passed        Boolean?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, examId])
}

model Flashcard {
  id             String    @id @default(cuid())
  userId         String
  wordId         String?
  front          String
  back           String
  notes          String?
  deck           String    @default("Allgemein")
  easeFactor     Float     @default(2.5)
  intervalDays   Float     @default(0)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  isFavorite     Boolean   @default(false)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       VocabWord?  @relation(fields: [wordId], references: [id], onDelete: SetNull)
  reviewLogs ReviewLog[]

  @@index([userId, dueAt])
}

model ReviewLog {
  id           String   @id @default(cuid())
  userId       String
  cardId       String
  rating       Int
  intervalDays Float
  reviewedAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
}

model StudyActivity {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  minutes   Int      @default(0)
  xp        Int      @default(0)
  lessons   Int      @default(0)
  cards     Int      @default(0)
  exercises Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model SkillScore {
  id        String    @id @default(cuid())
  userId    String
  skill     SkillArea
  score     Float     @default(0)
  samples   Int       @default(0)
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

// ────────────────── Notes, bookmarks, planner ─────────────────

model NoteFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
}

model Bookmark {
  id        String       @id @default(cuid())
  userId    String
  type      BookmarkType
  refId     String
  title     String
  href      String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, refId])
}

model PlannerItem {
  id        String          @id @default(cuid())
  userId    String
  date      DateTime        @db.Date
  title     String
  type      PlannerItemType @default(CUSTOM)
  href      String?
  done      Boolean         @default(false)
  notes     String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  id        String    @id @default(cuid())
  userId    String
  title     String
  metric    String    @default("xp")
  target    Int       @default(100)
  deadline  DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Community ─────────────────────────

model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isPrivate   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())

  owner      User             @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    GroupMember[]
  messages   GroupMessage[]
  challenges GroupChallenge[]
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupChallenge {
  id       String   @id @default(cuid())
  groupId  String
  title    String
  metric   String   @default("xp")
  target   Int      @default(500)
  startsAt DateTime @default(now())
  endsAt   DateTime

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  category  String   @default("Allgemein")
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([category, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────── Gamification ───────────────────────

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String @default("trophy")
  xp          Int    @default(25)
  tier        Int    @default(1)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  levelCode String
  score     Float
  serial    String   @unique
  issuedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Platform ──────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model DownloadItem {
  id          String  @id @default(cuid())
  title       String
  category    String
  description String?
  href        String
  levelCode   String?
  order       Int     @default(0)
}
